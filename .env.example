# Google Cloud Platform Configuration
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1

# Gemini Model Settings
# Options: gemini-1.5-flash (fast & cost-effective), gemini-1.5-pro (advanced reasoning), gemini-2.0-flash
GEMINI_MODEL=gemini-1.5-flash
MODEL_TEMPERATURE=0.7
MAX_OUTPUT_TOKENS=2048

# System Persona / Instruction
SYSTEM_INSTRUCTION="You are a helpful, knowledgeable, and concise AI assistant powered by Gemini on Google Cloud Platform."
